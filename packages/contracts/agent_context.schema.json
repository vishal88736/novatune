{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentContext",
  "description": "Contract for the payload website/backend sends to ai-engine/service when invoking any agent.",
  "type": "object",
  "required": ["user_id"],
  "properties": {
    "user_id": { "type": "string" },
    "session_id": { "type": "string" },
    "message": { "type": "string" },
    "text": { "type": "string" },
    "mood_tap": { "type": "string" }
  }
}
